PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_super_secret_key_here
CLIENT_ORIGIN=your_deployed_frontend_url
FRONTEND_URL=http://localhost:5173
JWT_EXPIRES_IN=7d
NODE_ENV=production #added for samesite domain setting in production and development environment 
# Firebase project configuration for backend token verification
FIREBASE_PROJECT_ID=your_firebase_project_id


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER= your mail id ....
SMTP_PASS= 16- character code , steps as follows below .
# Enable 2-Step Verification: Go to your Google Account Security page, turn on 2-Step Verification, and complete the setup.
# Generate App Password: Navigate directly to your Google App Passwords page.
# Name it: Give it a recognizable name (e.g., "My Website SMTP") and click Generate.
# Copy the password: Copy the 16-character code that appears (without spaces) and paste it into your app's SMTP settings.

EMAIL_FROM="DailyForge <no-reply@yourdomain.com>"


# Optional (dev only): allow unverified Firebase tokens when FIREBASE_PROJECT_ID is not configured.
# DO NOT enable this in production.
FIREBASE_AUTH_ALLOW_UNVERIFIED=false
#cloudinary
CLOUD_API_NAME=your_cloudinary_project_name
CLOUD_API_KEY=your_cloudinary_key
CLOUD_API_SECRET=your_cloudinary_secret
CLOUD_API_ENV=your_cloudinary_environmentvariable #see From API keys on cloudinary 

# 64-character hex key (32 bytes) used to encrypt/decrypt user 2FA TOTP secrets
TWO_FACTOR_ENCRYPTION_KEY=your_64_char_hex_key_here
